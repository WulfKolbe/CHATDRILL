latex: \begin{aligned} & g_{00}=\frac{1}{4}\left(f_{00}+f_{01}+f_{10}+f_{11}\right)=1+\frac{\delta^{2}}{2} x^{2}+\frac{\epsilon^{2}}{2} y^{2}+\cdots \\ & g_{01}=\frac{1}{4 \epsilon}\left(f_{00}-f_{01}+f_{10}-f_{11}\right)=y+\frac{\delta^{2}}{2} x^{2} y+\frac{\epsilon^{2}}{6} y^{3}+\cdots \\ & g_{10}=\frac{1}{4 \delta}\left(f_{00}+f_{01}-f_{10}-f_{11}\right)=x+\frac{\delta^{2}}{6} x^{3}+\frac{\epsilon^{2}}{2} x y^{2}+\cdots \\ & g_{11}=\frac{1}{4 \epsilon \delta}\left(f_{00}-f_{01}-f_{10}+f_{11}\right)=x y+\frac{\delta^{2}}{6} x^{3} y+\frac{\epsilon^{2}}{6} x y^{3}+\cdots \end{aligned}
