latex: \begin{gathered} \mathrm{MHS}_{C}(\mathbf{x})=\sum_{c \in C \cap \mathbb{Z}^{n}} \mathbf{x}^{c}=\sum_{p \in P \cap \mathbb{Z}^{n}} \mathbf{x}^{p}\left(\prod_{i=1}^{d}\left(\sum_{s_{i}=0}^{\infty} \mathbf{x}^{s_{i} c_{i}}\right)\right)= \\ \sum_{p \in P \cap \mathbb{Z}^{n}} \mathbf{x}^{p}\left(\prod_{i=1}^{d} \frac{1}{1-\mathbf{x}^{c_{i}}}\right)=\frac{\sum_{p \in P \cap \mathbb{Z}^{n}} \mathbf{x}^{p}}{\prod_{i=1}^{d}\left(1-\mathbf{x}^{c_{i}}\right)} \end{gathered}
