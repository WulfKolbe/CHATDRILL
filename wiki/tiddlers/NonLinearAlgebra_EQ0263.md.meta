latex: \begin{aligned} M_{2}= & \left(\mathbf{e}_{11}+\mathbf{e}_{22}\right) \otimes\left(\mathbf{f}_{11}+\mathbf{f}_{22}\right) \otimes\left(\mathbf{g}_{11}+\mathbf{g}_{22}\right) \\ & +\left(\mathbf{e}_{21}+\mathbf{e}_{22}\right) \otimes \mathbf{f}_{11} \otimes\left(\mathbf{g}_{21}-\mathbf{g}_{22}\right) \\ & +\mathbf{e}_{11} \otimes\left(\mathbf{f}_{12}-\mathbf{f}_{22}\right) \otimes\left(\mathbf{g}_{12}+\mathbf{g}_{22}\right) \\ & +\mathbf{e}_{22} \otimes\left(\mathbf{f}_{21}-\mathbf{f}_{11}\right) \otimes\left(\mathbf{g}_{11}+\mathbf{g}_{21}\right) \\ & +\left(\mathbf{e}_{11}+\mathbf{e}_{12}\right) \otimes \mathbf{f}_{22} \otimes\left(\mathbf{g}_{12}-\mathbf{g}_{11}\right) \\ & +\left(\mathbf{e}_{21}-\mathbf{e}_{11}\right) \otimes\left(\mathbf{f}_{11}+\mathbf{f}_{12}\right) \otimes \mathbf{g}_{22} \\ & +\left(\mathbf{e}_{12}-\mathbf{e}_{22}\right) \otimes\left(\mathbf{f}_{21}+\mathbf{f}_{22}\right) \otimes \mathbf{g}_{11} \end{aligned}
